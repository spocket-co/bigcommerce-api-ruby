# bigcommerce-api-ruby - environment
#
# Names only - no values in this file.
#
# Only BC_API_ENDPOINT is read by lib/. Everything else is read solely by the
# scripts under examples/, so that they can be run against a real store.
# rails-api uses none of these - it passes credentials as Config values and
# reads BIGCOMMERCE_CLIENT_ID / BIGCOMMERCE_CLIENT_SECRET itself.

# ---------------------------------------------- Read by the library
# Optional. Overrides the API base URL; unset or empty falls back to
# https://api.bigcommerce.com . Set only to point at a mock or proxy.
BC_API_ENDPOINT=

# ---------------------------------------------- examples/ only, OAuth
BC_STORE_HASH=
BC_CLIENT_ID=
# Secret - store access token from the OAuth token exchange.
BC_ACCESS_TOKEN=
# Secret - app client secret, for Customer Login API tokens.
BC_CLIENT_SECRET=

# ---------------------------------------------- examples/ only, legacy basic auth
BC_API_ENDPOINT_LEGACY=
BC_USERNAME=
# Secret - legacy basic-auth API key.
BC_API_KEY=
